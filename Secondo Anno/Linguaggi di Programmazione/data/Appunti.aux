\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}\textbf  {È possibile costruire un programma Check che, preso in input un qualunque programma P, restituisce 1 se P è corretto e 0 se P è scorretto? Ovvero existe un qualche compilatore che può scovare tutti i possibili errori di un programma?}}{4}{subsection.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}\textbf  {Cosa dice il problema della fermata (Halting Problem)? (L'errore in esame è la possibilità di non terminare il calcolo.) Come si dimostra che il problema non può essere risolto?}}{4}{subsection.5.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}\textit  {Quando un problema è decidibile?}}{4}{subsection.5.3}\protected@file@percent }
